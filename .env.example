# EventProbe 환경설정 예시
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 공용 PC에서는 사용 후 .env 를 지우세요.

# NVIDIA NIM (AI 상세 분석) API 키 — https://build.nvidia.com 에서 발급
# 값이 비어 있으면 AI 상세 분석 기능은 자동으로 꺼집니다(도구는 그대로 동작).
NVIDIA_API_KEY=

# (선택) 사용할 모델. 속도/품질 트레이드오프:
#   meta/llama-3.1-8b-instruct   → 빠름(권장, 페이로드 생성엔 충분)
#   meta/llama-3.1-70b-instruct  → 품질↑ 그러나 무료 티어에선 느리거나 타임아웃 가능
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# (선택) AI 호출 타임아웃(초). 기본 120. 느린 모델/네트워크면 늘리세요.
# AI_TIMEOUT=120

# (선택) 엔드포인트. 사내 로컬 NIM 을 쓰면 여기를 바꾸세요(응답 데이터가 외부로 안 나감).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI '응답 분석' 활성화 여부. 기본 false.
# ⚠️ true 로 켜면 대상 응답 body 가 AI(클라우드)로 전송됩니다 — 유출 위험.
# 페이로드 생성/우회변형 기능은 이 값과 무관하게 키만 있으면 동작합니다(요청/payload만 전송).
# 로컬 NIM(NVIDIA_BASE_URL) 을 쓰는 경우에만 true 를 권장.
AI_RESPONSE_ANALYSIS=false
