# EventProbe 환경설정 예시
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 공용 PC에서는 사용 후 .env 를 지우세요.

# ─── 서버 접근 제어 ─────────────────────────────────────────────────────────
# 바인딩 주소/포트. 기본은 127.0.0.1(루프백)이라 이 PC에서만 접속됩니다.
# 다른 PC에서 접속해야 할 때만 0.0.0.0 으로 열되, 반드시 EVENTPROBE_TOKEN 을
# 함께 설정하세요(그렇지 않으면 누구나 이 공격 프록시를 조종할 수 있습니다).
# HOST=127.0.0.1
# PORT=8000

# (선택) 접근 토큰. 값이 있으면 이 토큰 없이는 접속이 거부됩니다.
# 최초 1회 http://<HOST>:<PORT>/?token=<이 값> 으로 접속하면 쿠키가 심기고,
# 토큰은 URL/브라우저 히스토리에 남지 않도록 즉시 제거됩니다.
# 비워두면 가드가 꺼집니다(루프백 기본값에서만 안전).
# EVENTPROBE_TOKEN=

# NVIDIA NIM (AI 상세 분석) API 키 — https://build.nvidia.com 에서 발급
# 값이 비어 있으면 AI 상세 분석 기능은 자동으로 꺼집니다(도구는 그대로 동작).
NVIDIA_API_KEY=

# (선택) 사용할 모델. build.nvidia.com 에서 계정이 호출 가능한 모델로 지정.
#   nvidia/nemotron-3-super-120b-a12b     → 권장(타겟팅 정확·카테고리 다양·JSON 안정)
#   deepseek-ai/deepseek-v4-pro-0813      → 보안 추론 최상(로그인=인증우회 등), 다소 느림
#   nvidia/nemotron-3.5-lightning-30b-a3b → 빠름(정확도-속도 절충)
# 주의: llama-3.2-11b-vision 계열은 타겟팅 부정확(SQLi 누락)·간헐 500 → 페이로드 생성엔 부적합.
# 주의: 모델은 EOL(수명 종료)될 수 있음. 410/404 오류 시 계정에서 호출 가능한 모델로 교체.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# (선택) AI 호출 타임아웃(초). 기본 120. 느린 모델/네트워크면 늘리세요.
# AI_TIMEOUT=120

# (선택) 엔드포인트. 사내 로컬 NIM 을 쓰면 여기를 바꾸세요(응답 데이터가 외부로 안 나감).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── 제공자 무관 설정(로컬 모델로 교체하기) ─────────────────────────────────
# AI 호출은 OpenAI 호환 API 면 무엇이든 됩니다. 아래 AI_* 를 채우면 NVIDIA_* 대신
# 그 값을 씁니다(AI_* 우선, 없으면 NVIDIA_* 폴백). 코드 수정 없이 로컬 모델로 교체:
#   ollama :  AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.1   AI_API_KEY=ollama
#   vLLM   :  AI_BASE_URL=http://localhost:8000/v1     AI_MODEL=<served-model>  AI_API_KEY=x
#   LM Studio: AI_BASE_URL=http://localhost:1234/v1    AI_MODEL=<model>  AI_API_KEY=lm
# 로컬 모델을 쓰면 대상 응답이 외부로 나가지 않아 AI_RESPONSE_ANALYSIS=true 도 안전합니다.
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# ─── RAG 임베딩 설정 ────────────────────────────────────────────────────────
# 지정하지 않으면 기존 NVIDIA_* 설정을 사용합니다. AI_* 채팅 엔드포인트는 임베딩 API를
# 제공하지 않을 수 있으므로 자동 사용하지 않습니다. 다른 제공자나 로컬 임베딩 서버는
# EMBEDDING_* 중 하나 이상을 명시하세요(빠진 키/주소는 AI_* → NVIDIA_* 순서로 보완).
# 모델·본문·청킹 버전이 바뀌면 관리 UI에 '재색인 필요'로 표시됩니다.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# 기능별 프롬프트는 backend/prompts/*.md 에 있습니다(파일만 고치면 서버 재시작 없이 반영).
# 작은 로컬 모델은 JSON 준수가 약하니 필요하면 각 .md 의 출력 지시를 더 단순화하세요.

# AI 종합 판정(판정 결과 카드를 AI가 서술). 원본 응답 본문 전체와 인증 헤더는 제외하지만,
# 요청 경로·파라미터·본문 일부·판정 evidence와 검색된 RAG 발췌문은 전송합니다.
# AI는 결정적 판정을 바꾸지 않고 설명·우선순위·조치를 보강합니다. 끄려면 false.
# (매 요청 AI 호출이라 지연·비용이 붙습니다. 로컬 모델 권장)
AI_VERDICT=true

# AI '응답 분석' 활성화 여부. 기본 false.
# ⚠️ true 로 켜면 대상 응답 body 가 AI(클라우드)로 전송됩니다 — 유출 위험.
# 페이로드 생성/우회변형 기능은 이 값과 무관하게 키만 있으면 동작합니다(요청/payload만 전송).
# 로컬 NIM(NVIDIA_BASE_URL) 을 쓰는 경우에만 true 를 권장.
AI_RESPONSE_ANALYSIS=false

# ─── OOB(out-of-band) 콜백 — blind 계열(cmdi/ssrf/xxe/log4shell) 확증용 ─────────
# interactsh 서버에 붙어 DNS/HTTP 콜백을 받아 응답 탭 'OOB 콜백'에 표시한다.
# 기본 OFF. 켜면 페이로드의 {{oob}} 가 <랜덤>.<상관ID>.<도메인> 으로 치환된다.
# OOB_ENABLED=false
#
# 서버 선택:
#  - self-host(무유출·권장): deploy/interactsh/README.md 대로 무료 VM 에 구축 후 내 도메인 지정
#      OOB_SERVER=https://oob.example.com
#      OOB_DOMAIN=oob.example.com
#      OOB_TOKEN=<interactsh -auth 토큰>
#  - 공개 서버(무료·즉시, 단 제3자 경유 → 내부 타깃 유출 주의):
#      OOB_SERVER=https://oast.fun
# ⚠️ 내부/사내 타깃 점검 시엔 반드시 self-host(또는 사내 장비) 사용 — 공개 서버는 콜백·유출데이터가
#    제3자로 나갑니다. 툴은 내부 타깃 + 외부 OOB 조합을 감지해 경고합니다.
# OOB_POLL_SEC=5         # 폴링 주기(초)
