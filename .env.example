# EventProbe 환경설정 예시
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 공용 PC에서는 사용 후 .env 를 지우세요.

# ─── 서버 접근 제어 ─────────────────────────────────────────────────────────
# 바인딩 주소/포트. 기본은 127.0.0.1(루프백)이라 이 PC에서만 접속됩니다.
# 다른 PC에서 접속해야 할 때만 0.0.0.0 으로 열되, 반드시 EVENTPROBE_TOKEN 을
# 함께 설정하세요(그렇지 않으면 누구나 이 공격 프록시를 조종할 수 있습니다).
# HOST=127.0.0.1
# PORT=8000

# (선택) 접근 토큰. 값이 있으면 이 토큰 없이는 접속이 거부됩니다.
# 최초 1회 http://<HOST>:<PORT>/?token=<이 값> 으로 접속하면 쿠키가 심기고,
# 토큰은 URL/브라우저 히스토리에 남지 않도록 즉시 제거됩니다.
# 비워두면 가드가 꺼집니다(루프백 기본값에서만 안전).
# EVENTPROBE_TOKEN=

# NVIDIA NIM (AI 상세 분석) API 키 — https://build.nvidia.com 에서 발급
# 값이 비어 있으면 AI 상세 분석 기능은 자동으로 꺼집니다(도구는 그대로 동작).
NVIDIA_API_KEY=

# (선택) 사용할 모델. build.nvidia.com 에서 계정이 호출 가능한 모델로 지정.
#   nvidia/nemotron-3-super-120b-a12b     → 권장(타겟팅 정확·카테고리 다양·JSON 안정)
#   deepseek-ai/deepseek-v4-pro-0813      → 보안 추론 최상(로그인=인증우회 등), 다소 느림
#   nvidia/nemotron-3.5-lightning-30b-a3b → 빠름(정확도-속도 절충)
# 주의: llama-3.2-11b-vision 계열은 타겟팅 부정확(SQLi 누락)·간헐 500 → 페이로드 생성엔 부적합.
# 주의: 모델은 EOL(수명 종료)될 수 있음. 410/404 오류 시 계정에서 호출 가능한 모델로 교체.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# (선택) AI 호출 타임아웃(초). 기본 120. 느린 모델/네트워크면 늘리세요.
# AI_TIMEOUT=120

# (선택) 엔드포인트. 사내 로컬 NIM 을 쓰면 여기를 바꾸세요(응답 데이터가 외부로 안 나감).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI 종합 판정(판정 결과 카드를 AI가 서술). 라벨(판정/신호 이름·상태·시간)만 전송하고
# 대상 응답 데이터는 보내지 않아 유출 위험이 없음 → 키만 있으면 기본 ON. 끄려면 false.
# (매 요청 AI 호출이라 지연·비용이 붙습니다. 로컬 모델 권장)
AI_VERDICT=true

# AI '응답 분석' 활성화 여부. 기본 false.
# ⚠️ true 로 켜면 대상 응답 body 가 AI(클라우드)로 전송됩니다 — 유출 위험.
# 페이로드 생성/우회변형 기능은 이 값과 무관하게 키만 있으면 동작합니다(요청/payload만 전송).
# 로컬 NIM(NVIDIA_BASE_URL) 을 쓰는 경우에만 true 를 권장.
AI_RESPONSE_ANALYSIS=false
